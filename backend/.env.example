# MongoDB connection string
MONGO_URI=
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Origin of the frontend, no trailing slash (e.g. http://localhost:5173)
FRONTEND_URL=
# Public origin of this API, used for the Google OAuth callback (e.g. http://localhost:3000)
API_BASE_URL=
# Google OAuth client id and secret; leave both empty to disable Google sign-in
GOOGLE_ID=
GOOGLE_SECRET=
# "production" enables Secure + SameSite=None cookies
NODE_ENV=development
# Port the API listens on
PORT=3000
